# Agent-workflow environment — copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#
# Loaded automatically by `ghostc-agent` (bridge.env.load_env), searching
# $GHOSTC_ENV_FILE (used exclusively if set), then <repo-root>/.env, then ./.env.
# A value already set in the real environment (shell export, CI secret,
# `docker run -e`) is NEVER overridden by this file.
#
# `ghostc` (the deterministic compiler) needs NONE of these — it has no secrets.
# The runnable webapp fixture has its own config at fixtures/webapp/app/.env.example.

# ============================================================================
# Per-agent credentials
# ----------------------------------------------------------------------------
# The workflow has two agents: `client` (company-side orchestrator — planning +
# the consistency gate) and `consultancy` (the external coding agent). Each
# secret is read role-prefixed first, then bare:
#
#   CLIENT_ANTHROPIC_API_KEY  ─┐
#                              ├─►  ANTHROPIC_API_KEY   (shared fallback)
#   CONSULTANCY_ANTHROPIC_API_KEY ─┘
#
# One shared key works everywhere. Split them for separate billing / token
# attribution, separate LangSmith trace orgs, and blast-radius isolation —
# Phase E's `docker compose` then hands each service ONLY its own subset.
# ============================================================================

# --- shared fallback (used when a role-specific key is unset) ----------------
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=

# --- client agent (override the shared keys; optional) ----------------------
CLIENT_ANTHROPIC_API_KEY=
CLIENT_LANGSMITH_API_KEY=
CLIENT_LANGSMITH_PROJECT=ghostc-client

# --- consultancy agent (override the shared keys; optional) ----------------
CONSULTANCY_ANTHROPIC_API_KEY=
CONSULTANCY_LANGSMITH_API_KEY=
CONSULTANCY_LANGSMITH_PROJECT=ghostc-consultancy

# ============================================================================
# Shared settings
# ============================================================================

# auto  : Claude when an Anthropic key is set and the SDK imports, else stub
# claude: force real Claude (errors if key/SDK missing)
# stub  : force the deterministic stub (offline, reproducible)
GHOSTC_AGENT_BACKEND=auto

GHOSTC_AGENT_MODEL=claude-opus-5

# Tracing is on whenever a LangSmith key resolves for the role. Project name
# falls back {ROLE}_LANGSMITH_PROJECT -> LANGSMITH_PROJECT -> ghostc-<role>
# (any name works — LangSmith auto-creates it, e.g. "pr-excellent-harmony-28").
LANGSMITH_PROJECT=ghostc-agents
LANGSMITH_TRACING=true

# LangSmith region. Leave blank / unset for the US tenant; set the EU URL if your
# key was created in the EU tenant (a US default + an EU key => 403 Forbidden).
# {ROLE}_LANGSMITH_ENDPOINT overrides per agent.
LANGSMITH_ENDPOINT=
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# The agent workflow adds @traceable spans (bridge.trace) on top of the auto
# LangGraph + wrapped-Anthropic traces; nothing to configure here.
