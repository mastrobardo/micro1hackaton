  "cards": [
    {
      "dot": "rose",
      "title": "Two gates in front of the wire",
      "items": [
        "compile_spec fails closed on a residual configured spelling",
        "screen scores the compiled output and fails closed on an unknown one",
        "The LLM adjudicator may accuse only, never auto-alias"
      ]
    },
    {
      "dot": "cyan",
      "title": "The boundary is an import rule",
      "items": [
        "consultancy_agent may import bridge only; tests/test_boundary.py enforces it",
        "The handoff is a git push to a ghost remote, not a function call",
        "The external agent sees workspace/ghost/ and ghost-spec.md, nothing else"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence, not assertion",
      "items": [
        "Every step appends to audit.jsonl carrying real_sha256, never cleartext",
        "On the fixture: baseline leaves 28 residual occurrences, compile leaves 0",
        "Reverse patch rejects unmapped aliases and mapping-version mismatch"
      ]
    }
