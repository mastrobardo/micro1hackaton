  "cards": [
    {
      "dot": "rose",
      "title": "Fail closed, twice",
      "items": [
        "compile_spec blocks on a residual configured spelling",
        "screen blocks on an entity nobody configured",
        "handoff is the only node that writes ghost-side"
      ]
    },
    {
      "dot": "cyan",
      "title": "The wire is a git push",
      "items": [
        "handoff pushes to a bare ghost remote via bridge.forge",
        "The agent gets the ghost repo and spec, no mapping",
        "Production resumes this on a forge webhook"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nothing merges unreviewed",
      "items": [
        "reverse_patch rejects unmapped alias-shaped tokens",
        "verify re-scans the decoded patch and fails closed",
        "consistency feeds a human gate; it never merges"
      ]
    }
  ]
