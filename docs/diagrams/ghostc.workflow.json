{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ghostc \u2014 Round-trip Task Pipeline",
    "output": "docs/diagrams/ghostc-workflow.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "two-gates",
        "label": "Two gates before the wire",
        "focus": [
          "plan",
          "compile_spec",
          "screen",
          "handoff",
          "halt"
        ],
        "note": "compile_spec closes the known world, screen scores the unknown one; only then may handoff write ghost-side."
      },
      {
        "id": "crossing",
        "label": "Crossing the boundary",
        "focus": [
          "handoff",
          "ghost_dev",
          "await_pr"
        ],
        "note": "The handoff is a git push to a ghost remote, so the two agents stay separate processes."
      },
      {
        "id": "return",
        "label": "Decoding the ghost diff",
        "focus": [
          "await_pr",
          "reverse_patch",
          "verify",
          "consistency",
          "open_real_pr"
        ],
        "note": "The ghost diff is decoded against the mapping, leak-scanned, then judged before a human merges."
      }
    ]
  },
  "lanes": [
    {
      "id": "outbound",
      "label": "Company boundary \u2014 outbound (client_agent)"
    },
    {
      "id": "blocked",
      "label": "Fail closed \u2014 nothing crosses",
      "variant": "exception"
    },
    {
      "id": "external",
      "label": "External \u2014 untrusted (consultancy_agent)"
    },
    {
      "id": "inbound",
      "label": "Company boundary \u2014 return (client_agent)"
    }
  ],
  "mainPath": [
    "plan",
    "compile_spec",
    "screen",
    "handoff",
    "ghost_dev"
  ],
