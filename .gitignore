# --- Python env / build artifacts ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Pipeline working area (not part of the solution) ---
# real-repo copy, generated ghost repo, mapping store, audit log, eval output
workspace/
# agent-workflow working area (git remotes, scratch) + boundary-internal artifacts
# (mapping = real values, audit). workspace/ is deprecated — see memory/workspace-deprecated.md
.ghostc/

# --- Agent run metrics (generated; consumed as a CI/dashboard artifact) ---
# metrics/README.md + metrics/.gitkeep are tracked; the JSONL sink is not.
metrics/*.jsonl

# --- Secrets (ground rule 08) ---
# note: *.env.example / .env.example ARE tracked — placeholders only, no real values
.env
.env.local
*.local

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
